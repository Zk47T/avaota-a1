# Extra options on top of Orange Pi's linux-sun60iw2-current-a733.config
# so the Debian host can run redroid (Android in Docker).
# Binder cannot be a module in 6.6, so this needs a kernel rebuild.
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES=""
# Pressure stall info: Android lmkd uses it to kill apps under memory pressure
CONFIG_PSI=y
# Explicit fences: redroid / SurfaceFlinger tests use sw_sync
CONFIG_SW_SYNC=y
# Container networking as built-ins (stock config has them as modules, fine either way)
CONFIG_VETH=y
CONFIG_BRIDGE_NETFILTER=y
# Docker extras flagged by moby's contrib/check-config.sh:
# IPv6 NAT (Docker >=27 enables ip6tables by default), nftables firewall
# backend (Docker >=28), VLAN-aware bridges
CONFIG_IP6_NF_TARGET_MASQUERADE=m
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NFT_FIB_INET=m
CONFIG_BRIDGE_VLAN_FILTERING=y
# Scheduling / memory for 2 Android instances on 2xA76 + 6xA55:
# uclamp lets Android (and cgroups) boost the foreground app onto the A76s;
# EAS uses the dynamic-power-coefficient already in the A733 DT;
# MGLRU reclaims better under memory pressure (4 GB boards + zram).
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_UCLAMP_BUCKETS_COUNT=20
CONFIG_ENERGY_MODEL=y
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_CRYPTO_LZ4=y
